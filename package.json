{
  "name": "fund-comparison-platform",
  "version": "1.0.0",
  "description": "以基金经理为核心的全市场基金对比平台（数据来源：天天基金/东方财富公开接口）",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "bun ./client/build.mjs",
    "start": "bun run server/src/standalone.ts",
    "dev": "bun run server/src/standalone.ts",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@fund-platform/sdk": "file:./packages/sdk",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  }
}
